{
    "name": "shankscode/haki",
    "description": "Miniframework PHP simples para APIs REST, com rotas, injeção de dependências, middleware e autenticação JWT própria.",
    "type": "library",
    "license": "MIT",
    "keywords": ["framework", "microframework", "router", "jwt", "api", "rest", "dump"],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "ext-pdo_sqlite": "Necessária para o armazenamento padrão de tokens da autenticação JWT",
        "ext-pdo": "Necessária apenas se você usar o EloPHP (ORM opcional)"
    },
    "autoload": {
        "psr-4": {
            "Haki\\": "src/",
            "Elo\\": "src/Elo/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Haki\\Tests\\": "tests/",
            "App\\": "tests/Fixtures/app/app/"
        }
    },
    "bin": [
        "bin/haki",
        "bin/elo"
    ],
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
