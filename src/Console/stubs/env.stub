APP_ENV=development

# Necessário só se usar autenticação. Gere com: php vendor/bin/haki key:generate
JWT_SECRET=

# Banco de dados (teste a conexão com: php vendor/bin/haki db)
# SQLite (um arquivo, não precisa de servidor):
# DB_CONNECTION=sqlite
# DB_DATABASE=database/app.sqlite
#
# MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=nome_do_banco
# DB_USERNAME=root
# DB_PASSWORD=
